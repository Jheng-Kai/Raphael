# The desktop image context is read inside Linux; shell steps break on CRLF.
core/src/raphael_core/computer/image/** text eol=lf

# The product rules are a ledger of independent rows: two branches that each add a section or a row keep both when
# they meet (a row both changed then appears twice, which the rule tests refuse by its duplicate ID).
.agents/product/RULES.md merge=union
.agents/product/rules/*.md merge=union

# Signed catalogue fixtures: their bytes are hashed and signed, so no line-ending conversion.
core/tests/fixtures/member-catalog/** -text
