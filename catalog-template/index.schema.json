{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "raphael-catalog"
    },
    "version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "creator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "enum": [
              "engineering",
              "sales",
              "marketing",
              "design",
              "personal",
              "hr",
              "product",
              "operations"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "avatar": {
            "enum": [
              "rimuru",
              "souei",
              "shuna",
              "diablo",
              "benimaru",
              "hakurou",
              "shion",
              "gobta"
            ]
          },
          "featured": {
            "type": "boolean"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "created": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "updated": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "skills": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "routines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 30
          }
        },
        "required": [
          "id",
          "name",
          "creator",
          "category",
          "summary",
          "avatar",
          "featured",
          "package",
          "sha256",
          "version",
          "created",
          "updated",
          "skills",
          "routines",
          "connections"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      },
      "maxItems": 2000
    }
  },
  "required": [
    "format",
    "version",
    "sequence",
    "entries",
    "revoked"
  ],
  "additionalProperties": false
}
