                          },
                          "arguments": {
                            "type": "object"
                          },
                          "items": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^[A-Za-z0-9_.-]*$"
                          },
                          "id": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^[A-Za-z0-9_.-]*$",
