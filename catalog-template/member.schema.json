    "format": {
      "const": "raphael-member"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "role": {
      "type": "string",
      "minLength": 0,
      "maxLength": 24
    },
    "personality": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2000
    },
    "instructions": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2000
    },
    "reply_style": {
      "enum": [
        "full",
        "conversational"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 280
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 131072
          },
          "files": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 0,
              "maxLength": 131072
            }
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 40
    },
    "routines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
