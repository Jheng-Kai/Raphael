                            "required": [
                              "arg",
                              "format"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "tool",
                          "arguments",
                          "items",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      "filter": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^[A-Za-z0-9_.-]*$"
                          },
                          "equals": {
                            "type": "string",
                            "minLength": 0,
                            "maxLength": 300
                          },
                          "operator": {
                            "enum": [
                              "equals",
                              "contains"
                            ]
                          }
                        },
                        "required": [
                          "field",
                          "equals"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "app",
                      "event",
                      "filter"
                    ],
                    "additionalProperties": false
