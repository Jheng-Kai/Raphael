                  "kind": {
                    "enum": [
                      "once",
                      "daily",
                      "weekdays",
                      "weekly",
                      "monthly",
                      "every"
                    ]
                  },
                  "time": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "maxItems": 7,
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "hours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 1440
                  },
                  "day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 100
                  },
                  "start_date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "until": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "max_runs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "enum": [
                            "daily",
                            "weekdays",
                            "weekly",
                            "monthly",
                            "once"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "time"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "weekly"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "days"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "monthly"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "day"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "once"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "start_date"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "every"
                        }
                      }
                    },
                    "then": {
                      "oneOf": [
                        {
                          "required": [
                            "hours"
                          ]
                        },
                        {
                          "required": [
                            "minutes"
                          ]
                        }
                      ]
                    }
